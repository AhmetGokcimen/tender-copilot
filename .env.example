# Copy to .env and fill in real values. Never commit .env.

# api.meta.ai's Responses API (confirmed live 2026-10-26 — see core/config.py
# for the exact request shape). Leave base URL/model unset to use the
# defaults there unless using a different gateway.
META_API_KEY=
META_API_BASE_URL=
META_MODEL=

# Storage
DATABASE_URL=sqlite:///./data/app.db

# App
APP_ENV=development
LOG_LEVEL=info

# Auth: every /api/* call except /api/auth/* needs an
# `Authorization: Bearer <JWT>` header. Get one via /api/auth/demo
# (one click, fixed demo user) or /api/auth/google/login.
# The dev default below keeps local setup frictionless — set a long
# random value before anything public, or anyone can mint tokens.
JWT_SECRET=dev-only-insecure-change-me

# Google OAuth 2.0 (authorization code flow). Create OAuth credentials at
# console.cloud.google.com (web app), register the redirect URI
# {BACKEND_URL}/api/auth/google/callback, and paste both values here.
# In production BACKEND_URL is the single deployed origin (same-origin
# with the frontend); locally it is http://localhost:8000.
# Leave empty to disable Google login (demo login still works).
# NEVER commit the real secret — this file holds placeholders only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where the frontend runs (login redirects land at
# {FRONTEND_URL}/auth/callback?token=...) and where this API runs.
# Local dev is two processes (3000 + 8000); in production both are the
# single deployed origin, e.g. https://ofera.vercel.app
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Comma-separated CORS allow-list — no wildcard. Only needed for local
# two-process dev (production is same-origin, so CORS never triggers).
ALLOWED_ORIGINS=http://localhost:3000

# Shared secret for POST /internal/sync-tenders (sent as X-Sync-Token by
# the scheduled GitHub Actions workflow). Long random value; empty disables
# the endpoint (503). The Actions workflow reads this from repo secrets.
SYNC_SECRET=

# --- Frontend (Next.js) ---
# "true" = serve mock data shaped like the backend JSON; "false" = call the real API
NEXT_PUBLIC_USE_MOCK=true
# Optional override: the API base URL. Leave UNSET for same-origin (/api) —
# production and local `next dev` (which proxies /api to localhost:8000).
# Set only to point at a remote API explicitly.
# NEXT_PUBLIC_API_URL=http://localhost:8000/api
