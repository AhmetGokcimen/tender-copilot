    "/api/companies/{company_id}/score": {
      "post": {
        "tags": [
          "companies"
        ],
        "summary": "Score Tenders For Company",
        "description": "Score every stored tender against one company profile and persist\nthe result. Safe to re-run: upsert_score only ever touches score\nfields, never the AI/eligibility fields other steps will fill in.",
        "operationId": "score_tenders_for_company_api_companies__company_id__score_post",
        "parameters": [
          {
            "name": "company_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Company Id"
            }
          },
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UserTenderState"
                  },
                  "title": "Response Score Tenders For Company Api Companies  Company Id  Score Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/companies/{company_id}/enrich": {
      "post": {
        "tags": [
          "companies"
        ],
        "summary": "Enrich Tenders For Company",
        "description": "Call the AI layer for tenders that scored high enough to be worth it\nand don't have a summary yet (cost control, same spirit as the scoring\nthreshold: don't spend an AI call on something already filtered out).\n`limit` caps how many calls this request makes.",
        "operationId": "enrich_tenders_for_company_api_companies__company_id__enrich_post",
        "parameters": [
          {
            "name": "company_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Company Id"
            }
