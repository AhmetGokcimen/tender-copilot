    "/api/companies/{company_id}/tenders/romania/{external_id}/eligibility": {
      "post": {
        "tags": [
          "companies"
        ],
        "summary": "Check Tender Eligibility",
        "description": "Compare one tender's extracted requirements against one company\nprofile. Turnover/similar-experience-value are checked deterministically\nin core.eligibility first; the AI layer gets those results as given\nfacts and only has to reason about certification matching and the\nfinal justification — not redo arithmetic.",
        "operationId": "check_tender_eligibility_api_companies__company_id__tenders_romania__external_id__eligibility_post",
        "parameters": [
          {
            "name": "company_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Company Id"
            }
          },
          {
            "name": "external_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "External Id"
            }
          },
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserTenderState"
