{
  "openapi": "3.1.0",
  "info": {
    "title": "Tender Copilot API",
    "description": "Multi-country public-procurement copilot backend. Only Romania/SEAP is implemented so far — see the repo README for the adapter architecture. Open (no auth) unless API_KEY is set in the backend's environment, in which case every /api/* call needs an X-API-Key header.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/tenders": {
      "get": {
        "tags": [
          "tenders"
        ],
        "summary": "List Tenders",
        "description": "Raw tender listing, filterable and paginated. For a feed that\nincludes score/AI/eligibility output for a specific company, use\nGET /companies/{id}/tenders instead.",
        "operationId": "list_tenders_api_tenders_get",
        "parameters": [
          {
            "name": "country_code",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Country Code"
            }
          },
          {
            "name": "cpv_code",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cpv Code"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "default": 50,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0,
              "title": "Offset"
            }
          },
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TenderPage"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/tenders/sync/romania": {
      "post": {
        "tags": [
          "tenders"
        ],
        "summary": "Sync Romania Tenders",
        "operationId": "sync_romania_tenders_api_tenders_sync_romania_post",
