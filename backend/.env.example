# Copy to .env and fill in real values. Never commit .env.

# Meta's official Llama API, OpenAI-compatible mode (https://api.llama.com).
# Get a key at https://llama.developer.meta.com. Leave base URL/model unset
# to use the defaults in core/config.py unless using a different gateway.
META_API_KEY=
META_API_BASE_URL=
META_MODEL=

# Storage
DATABASE_URL=sqlite:///./data/app.db

# App
APP_ENV=development
LOG_LEVEL=info
