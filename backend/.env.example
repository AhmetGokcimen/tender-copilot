# Copy to .env and fill in real values. Never commit .env.

# api.meta.ai's Responses API (confirmed live 2026-10-26 — see core/config.py
# for the exact request shape). Leave base URL/model unset to use the
# defaults there unless using a different gateway.
META_API_KEY=
META_API_BASE_URL=
META_MODEL=

# Storage
DATABASE_URL=sqlite:///./data/app.db

# App
APP_ENV=development
LOG_LEVEL=info

# Leave empty for the demo (open API, zero setup for the frontend). Set
# this only once deployed somewhere public, to require an X-API-Key
# header on every /api/* request.
API_KEY=
# "*" (default) allows any origin — fine for the demo. Comma-separated
# list to restrict, e.g. http://localhost:3000,https://your-frontend.app
ALLOWED_ORIGINS=*
